# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
Library/
[Ll]ibrary/
Temp/
[Tt]emp/
Obj/
[Oo]bj/
Build/
[Bb]uild/
Builds/
[Bb]uilds/
Logs/
[Ll]ogs/
UserSettings/
[Uu]ser[Ss]ettings/
MemoryCaptures/
Recordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/
.vsconfig

# Plastic SCM
.plastic/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.pdb.meta
*.raw
*.raw.meta

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D Generated File On Crash Reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Large raw / work / bake source files (>50MB / unreferenced bakes)
*.psd
*.psd.meta
*.zip
*.7z
*.tar.gz
*.mp4
bake_normal.psd*

# Scratch test files
gun_inspect.txt
instantiate_check.txt
vert_check.txt
push_to_github.bat

# OS generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
